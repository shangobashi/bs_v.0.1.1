# Backend Configuration
DEBUG=False
APP_NAME=SwarmAgents WebUI MVP
APP_VERSION=0.1.0

# API Keys
ANTHROPIC_API_KEY=your-claude-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_API_KEY=your-google-gemini-api-key-here

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_EXECUTION_ENABLED=False
PUBLIC_EXECUTION_MAX_TOKENS=1024
PUBLIC_EXECUTION_RATE_LIMIT_WINDOW_SECONDS=900
PUBLIC_EXECUTION_RATE_LIMIT_MAX_REQUESTS=12
RUNTIME_KEY_CONFIG_ENABLED=False
RUNTIME_KEY_CONFIG_PERSIST_TO_ENV=False

# Agent Configuration
MAX_CONCURRENT_AGENTS=10
AGENT_TIMEOUT_SECONDS=300

# Frontend
REACT_APP_API_BASE_URL=http://localhost:8000/api/v1
