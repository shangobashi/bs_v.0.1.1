{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        }
    ],
    "framework": "create-react-app",
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/build",
    "functions": {
        "api/index.py": {
            "includeFiles": "backend/**"
        }
    }
}